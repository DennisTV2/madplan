# MadPlan — Simply.com .htaccess
Options -Indexes

# Skjulte filer (.git, .env, .ftp-deploy-sync-state.json) og cache-mappen må aldrig serveres
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule (^|/)\.(?!well-known/) - [F,L]
  RewriteRule ^cache/ - [F,L]
</IfModule>

# Konfiguration og udviklingsfiler må ikke kunne hentes
<FilesMatch "^(config\.php|config\.example\.php|setup\.php|server\.js|package(-lock)?\.json|README\.md)$">
  Require all denied
</FilesMatch>

# Sikkerhedsheaders
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

# Gzip komprimering
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
</IfModule>

# Cache headers
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  # CSS/JS revalideres ved hvert besøg (ETag gør det billigt) – så nye
  # deploys altid slår igennem uden at man skal huske at bumpe ?v=
  ExpiresByType text/css "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 0 seconds"
  ExpiresByType text/javascript "access plus 0 seconds"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# Service Worker skal have no-cache
<FilesMatch "sw\.js$">
  Header set Cache-Control "no-cache, no-store, must-revalidate"
  Header set Pragma "no-cache"
  Header set Expires 0
</FilesMatch>

# Alle requests → index.html (SPA routing)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>
